# ============================================================
# Brain–Body–Energy Generative Model
# CLEAN LAYERED + NON-CIRCULAR + ROBUST STATISTICS
# ============================================================

import os
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

from joblib import Parallel, delayed
from sklearn.linear_model import LinearRegression
from scipy.stats import pearsonr
import multiprocessing

# ============================================================
# GLOBAL PARAMETERS (EXPANDED SCOPE = CLUSTER-READY)
# ============================================================

NETWORK_SIZES = [40, 80, 120]
N_NETWORKS_PER_SIZE = 3
SEEDS_PER_NETWORK = 10
N_SUBJECTS_PER_SEED = 50

# PARAMETER SWEEP (EXPONENTIAL COMPLEXITY CONTROLLED)
G_VALS = np.linspace(0.2, 1.0, 5)
K_BODY_VALS = np.linspace(0.02, 0.08, 5)
K_ENERGY_VALS = np.linspace(0.02, 0.08, 5)
NOISE_VALS = np.linspace(0.01, 0.05, 5)

T = 300
DT = 0.05
STEPS = int(T / DT)

SAVE_DIR = "BrainBodyEnergy_Publishable"
os.makedirs(SAVE_DIR, exist_ok=True)

N_CORES = multiprocessing.cpu_count()
SEED_GLOBAL = 42
rng_global = np.random.default_rng(SEED_GLOBAL)

# ============================================================
# NETWORK LAYER
# ============================================================

def small_world(N, k=6, p=0.2, seed=None):
    rng = np.random.default_rng(seed)
    W = np.zeros((N, N))

    for i in range(N):
        for j in range(1, k // 2 + 1):
            W[i, (i + j) % N] = 1
            W[i, (i - j) % N] = 1

    for i in range(N):
        for j in range(N):
            if W[i, j] == 1 and rng.random() < p:
                W[i, j] = 0
                new = rng.integers(N)
                while new == i or W[i, new] == 1:
                    new = rng.integers(N)
                W[i, new] = 1

    W = (W + W.T) / 2
    np.fill_diagonal(W, 0)
    return W


def graph_laplacian(W):
    return np.diag(W.sum(axis=1)) - W


# ============================================================
# BODY LAYER (INDEPENDENT GENERATOR)
# ============================================================

def simulate_body(seed):
    rng = np.random.default_rng(seed)
    phase = 0
    heart = []

    for _ in range(STEPS):
        phase += 2*np.pi*1.2*DT + rng.normal(0, 0.01)
        heart.append(np.sin(phase))

    return np.array(heart)


# ============================================================
# ENERGY–BRAIN DYNAMICS (NON-CIRCULAR)
# ============================================================

def simulate_brain_energy(L, G, noise, heart, K_BODY, K_ENERGY, seed):
    rng = np.random.default_rng(seed)

    N = L.shape[0]
    z = rng.normal(size=N) + 1j*rng.normal(size=N)
    omega = rng.uniform(8, 12, N) * 2*np.pi / 100

    E = 1.0
    decay = 0.02

    power = np.zeros((STEPS, N))
    energy = np.zeros(STEPS)

    for t in range(STEPS):

        brain_power = np.mean(np.abs(z)**2)

        prod = 0.4 + 0.2 * heart[t]
        cons = 0.05 * brain_power

        dE = prod - cons - decay * E
        E = max(E + dE * DT, 0)

        forcing = K_BODY * heart[t] + K_ENERGY * E

        coupling = -G * (L @ z)
        intrinsic = (0.02 + 1j*omega - np.abs(z)**2) * z

        noise_term = noise * np.sqrt(DT) * (
            rng.normal(size=N) + 1j*rng.normal(size=N)
        )

        z += (intrinsic + coupling + forcing*z + noise_term) * DT

        power[t] = np.abs(z)**2
        energy[t] = E

    return power, energy


# ============================================================
# METRICS
# ============================================================

def coherence(sig1, sig2):
    phase1 = np.angle(sig1)
    phase2 = np.angle(sig2)
    return np.abs(np.mean(np.exp(1j*(phase1-phase2))))


def energy_stats(E):
    return np.std(E), np.mean(E)


def cognition_proxy(heart, noise):
    # fully independent latent process (NO leakage)
    return np.mean(heart) + noise * np.random.randn()


# ============================================================
# EFFECT SIZES
# ============================================================

def cohens_d(x, y):
    nx, ny = len(x), len(y)
    pooled = np.sqrt((np.var(x) + np.var(y)) / 2)
    return (np.mean(x) - np.mean(y)) / (pooled + 1e-8)


def partial_eta_squared(ss_effect, ss_total):
    return ss_effect / (ss_total + 1e-8)


# ============================================================
# BOOTSTRAP MEDIATION
# ============================================================

def bootstrap_mediation(X, M, Y, n_boot=500):
    rng = np.random.default_rng(0)
    indirects = []

    X, M, Y = np.array(X), np.array(M), np.array(Y)

    for _ in range(n_boot):
        idx = rng.integers(0, len(X), len(X))

        Xb, Mb, Yb = X[idx], M[idx], Y[idx]

        a = LinearRegression().fit(Xb.reshape(-1,1), Mb).coef_[0]
        b = LinearRegression().fit(np.column_stack([Xb, Mb]), Yb).coef_[1]

        indirects.append(a * b)

    return {
        "indirect": np.mean(indirects),
        "ci_low": np.percentile(indirects, 2.5),
        "ci_high": np.percentile(indirects, 97.5)
    }


# ============================================================
# SUBJECT SIMULATION
# ============================================================

def simulate_subject(job):

    W, net_id, seed, subj, G, Kb, Ke, noise = job
    L = graph_laplacian(W)

    heart = simulate_body(seed + subj)

    power, E = simulate_brain_energy(
        L, G, noise, heart, Kb, Ke, seed + subj
    )

    brain = np.mean(power, axis=1)

    cog = cognition_proxy(heart, noise)

    return {
        "NetworkID": net_id,
        "G": G,
        "K_BODY": Kb,
        "K_ENERGY": Ke,
        "Noise": noise,
        "BrainBody": coherence(brain, heart),
        "EnergyMean": np.mean(E),
        "EnergyStd": np.std(E),
        "Cognition": cog
    }


# ============================================================
# JOBS (FULL PARAMETER SWEEP)
# ============================================================

def create_jobs():
    jobs = []
    net_id = 0

    for N in NETWORK_SIZES:
        for i in range(N_NETWORKS_PER_SIZE):
            W = small_world(N, seed=i)

            for G in G_VALS:
                for Kb in K_BODY_VALS:
                    for Ke in K_ENERGY_VALS:
                        for noise in NOISE_VALS:
                            for seed in range(SEEDS_PER_NETWORK):
                                for subj in range(N_SUBJECTS_PER_SEED):
                                    jobs.append((W, net_id, seed, subj, G, Kb, Ke, noise))

            net_id += 1

    return jobs


# ============================================================
# MAIN
# ============================================================

if __name__ == "__main__":

    print("Jobs building...")
    jobs = create_jobs()
    print("Total simulations:", len(jobs))

    print("Running simulation...")
    df = Parallel(n_jobs=N_CORES, verbose=10)(
        delayed(simulate_subject)(j) for j in jobs
    )

    df = pd.DataFrame(df)

    df.to_csv(os.path.join(SAVE_DIR, "dataset.csv"), index=False)

    # ========================================================
    # CONDITION EFFECT SIZE ANALYSIS
    # ========================================================

    results = []

    for g in df["G"].unique():

        sub = df[df["G"] == g]

        high = sub[sub["BrainBody"] > sub["BrainBody"].median()]["Cognition"]
        low = sub[sub["BrainBody"] <= sub["BrainBody"].median()]["Cognition"]

        d = cohens_d(high, low)

        ss_total = np.var(sub["Cognition"])
        ss_effect = np.var(sub["BrainBody"])

        eta = partial_eta_squared(ss_effect, ss_total)

        results.append({
            "G": g,
            "Cohens_d": d,
            "Eta2": eta
        })

    res_df = pd.DataFrame(results)
    res_df.to_csv(os.path.join(SAVE_DIR, "effect_sizes.csv"), index=False)

    print(res_df)
