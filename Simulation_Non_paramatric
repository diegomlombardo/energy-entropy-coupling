# ============================================================
# BRAIN–HEART–RESPIRATION–ENERGY MODEL
# FULL NON-PARAMETRIC SPEARMAN VERSION
#
# Includes:
# - Spearman correlation coupling
# - Spearman permutation p-values
# - Spearman correlation matrix
# - Spearman bootstrap mediation
# - Bootstrap confidence intervals
# ============================================================


import os
import multiprocessing

import numpy as np
import pandas as pd

import matplotlib.pyplot as plt
import seaborn as sns

from joblib import Parallel, delayed

from scipy.stats import spearmanr



# ============================================================
# PARAMETERS
# ============================================================


NETWORK_SIZES = [
    40,
    80,
    120
]


N_NETWORKS_PER_SIZE = 5

SEEDS_PER_NETWORK = 20

N_SUBJECTS_PER_SEED = 50



T = 500

DT = 0.05

STEPS = int(
    T / DT
)



K_BODY_VALS = [
    0.03,
    0.05,
    0.07
]


K_ENERGY_VALS = [
    0.03,
    0.05,
    0.07
]



N_BOOT = 1000

N_PERM = 1000



