# ============================================================
# ROBUST CROSS-VALIDATED PREDICTION FUNCTION
# ============================================================


def evaluate_model(
        data,
        predictors,
        outcome,
        n_boot=500,
        seed=42
):


    clean = data.dropna(
        subset=predictors + [outcome]
    )



    N = len(clean)



    if N < 20:

        return {

            "R2": np.nan,

            "CI_low": np.nan,

            "CI_high": np.nan,

            "RMSE": np.nan,

            "MAE": np.nan,

            "N": N

        }



    X = clean[predictors].values

    y = clean[outcome].values



    cv = KFold(

        n_splits=5,

        shuffle=True,

        random_state=seed

    )



    r2_scores = []

    rmse_scores = []

    mae_scores = []



    # --------------------------------------------------------
    # Cross validation
    # --------------------------------------------------------


    for train, test in cv.split(X):


        model = clone(
            ridge_model
        )


        model.fit(

            X[train],

            y[train]

        )



        pred = model.predict(
            X[test]
        )



        r2 = r2_score(

            y[test],

            pred,

            force_finite=False

        )



        rmse = np.sqrt(

            mean_squared_error(

                y[test],

                pred

            )

        )


        mae = mean_absolute_error(

            y[test],

            pred

        )



        r2_scores.append(
            r2
        )


        rmse_scores.append(
            rmse
        )


        mae_scores.append(
            mae
        )



    real_r2 = np.nanmean(
        r2_scores
    )


    real_rmse = np.nanmean(
        rmse_scores
    )


    real_mae = np.nanmean(
        mae_scores
    )



    # --------------------------------------------------------
    # Bootstrap CI
    # --------------------------------------------------------


    rng = np.random.default_rng(
        seed
    )


    boot_scores = []



    for _ in range(n_boot):


        idx = rng.choice(

            np.arange(N),

            size=N,

            replace=True

        )


        Xb = X[idx]

        yb = y[idx]



        fold_scores = []



        for train, test in cv.split(Xb):


            model = clone(
                ridge_model
            )


            model.fit(

                Xb[train],

                yb[train]

            )



            pred = model.predict(
                Xb[test]
            )



            score = r2_score(

                yb[test],

                pred,

                force_finite=False

            )


            fold_scores.append(
                score
            )



        boot_scores.append(

            np.nanmean(
                fold_scores
            )

        )



    boot_scores = np.asarray(
        boot_scores
    )



    CI = np.nanpercentile(

        boot_scores,

        [

            2.5,

            97.5

        ]

    )



    return {


        "R2":

            real_r2,


        "CI_low":

            CI[0],


        "CI_high":

            CI[1],


        "RMSE":

            real_rmse,


        "MAE":

            real_mae,


        "N":

            N

    }





# ============================================================
# STANDARDIZED BETAS
# ============================================================


def standardized_betas(

        data,

        predictors,

        outcome

):


    clean = data.dropna(

        subset=predictors+[outcome]

    )


    if len(clean)<20:


        return [

            np.nan

            for _ in predictors

        ]



    X = StandardScaler().fit_transform(

        clean[predictors]

    )



    y = StandardScaler().fit_transform(

        clean[[outcome]]

    ).ravel()



    model = Ridge(

        alpha=1.0

    )


    model.fit(

        X,

        y

    )



    return model.coef_





