for outcome in outcomes:

    print(
        f"\nOUTCOME: {outcome}\n"
    )


    r2_table = (

        comparison[
            comparison["Outcome"] == outcome
        ]

        .pivot_table(

            index="Age",

            columns="Model",

            values="R2"

        )

        .reindex(
            columns=comparison_models
        )

    )


    print(
        r2_table.to_string(
            float_format=lambda x:
