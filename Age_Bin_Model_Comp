# 28. PRINT COMPLETE RESULTS IN TERMINAL
# ============================================================

pd.set_option(
    "display.max_rows",
    500
)

pd.set_option(
    "display.max_columns",
    20
)

pd.set_option(
    "display.width",
    200
)

pd.set_option(
    "display.float_format",
    lambda x: f"{x:.4f}"
)


# ============================================================
# COMPLETE AGE-BIN COMPARISON
# ============================================================

print(
    "\n\n"
    + "=" * 110
)

print(
    "COMPLETE AGE-BIN MODEL COMPARISON"
)

print(
    "=" * 110
)


for outcome in outcomes:

    print(
        "\n\n"
        + "#" * 110
    )

    print(
        f"OUTCOME: {outcome}"
    )

    print(
        "#" * 110
    )


    subset = comparison[
        comparison["Outcome"] == outcome
    ].copy()


    # --------------------------------------------------------
    # PRINT AGE BIN BY AGE BIN
    # --------------------------------------------------------

    for age in sorted(
        subset["Age"].unique()
    ):

        age_data = subset[
            subset["Age"] == age
        ].copy()


        age_data = age_data.sort_values(
            "R2",
            ascending=False
        )


        print(
            "\n"
            + "-" * 110
        )

        print(
            f"AGE BIN: {age:.1f} years"
        )

        print(
            "-" * 110
        )


        display_columns = [

            "Model",

            "R2",

            "CI_low",

            "CI_high",

            "Standardized_Beta",

            "Mean_Absolute_Beta",

            "R2_Rank",

            "Importance_Rank"

        ]


        print(

            age_data[
                display_columns
            ].to_string(
                index=False
            )

        )


# ============================================================
