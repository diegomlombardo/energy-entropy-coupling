# ============================================================
# GLOBAL PARAMETERS (EXPLOSIVE BUT CONTROLLED)
# ============================================================

NETWORK_SIZES = [40, 80, 120]
N_NETWORKS_PER_SIZE = 3
SEEDS_PER_NETWORK = 10
N_SUBJECTS_PER_SEED = 40

T = 400
DT = 0.05
STEPS = int(T / DT)

G_VALS = [0.3, 0.6, 0.9]
NOISE_VALS = [0.01, 0.03, 0.05]
COUPLING_VALS = [0.02, 0.05, 0.1]

SAVE_DIR = "BrainBodyEnergy_BayesianTopTier"
os.makedirs(SAVE_DIR, exist_ok=True)

N_CORES = multiprocessing.cpu_count()
rng_global = np.random.default_rng(42)

# ============================================================
# NETWORKS
# ============================================================

def small_world(N, seed=None):
    rng = np.random.default_rng(seed)
    W = np.zeros((N, N))
    k = 6

    for i in range(N):
        for j in range(1, k//2+1):
            W[i,(i+j)%N] = 1
            W[i,(i-j)%N] = 1

    for i in range(N):
        for j in range(N):
            if W[i,j] == 1 and rng.random() < 0.2:
                W[i,j] = 0
                new = rng.integers(N)
                while new == i or W[i,new] == 1:
                    new = rng.integers(N)
                W[i,new] = 1

    W = (W + W.T) / 2
    np.fill_diagonal(W, 0)
    return W

def laplacian(W):
    return np.diag(W.sum(axis=1)) - W

# ============================================================
# BODY (external driver only)
# ============================================================

def body_signal(seed):
    rng = np.random.default_rng(seed)
    phase = 0
    out = []

    for _ in range(STEPS):
        phase += 2*np.pi*1.2*DT + rng.normal(0, 0.01)
        out.append(np.sin(phase))

    return np.array(out)

# ============================================================
# BRAIN DYNAMICS
# ============================================================

def brain_sim(L, G, noise, body, coupling, seed):

    rng = np.random.default_rng(seed)
    N = L.shape[0]

    z = rng.normal(size=N) + 1j*rng.normal(size=N)
    omega = rng.uniform(8, 12, N) * 2*np.pi/100

    power = np.zeros((STEPS, N))
    brain_ts = np.zeros(STEPS)

    for t in range(STEPS):

        bp = np.mean(np.abs(z)**2)
        brain_ts[t] = bp

        coupling_term = -G * coupling * (L @ z)
        intrinsic = (0.02 + 1j*omega - np.abs(z)**2) * z
        noise_term = noise*np.sqrt(DT)*(rng.normal(size=N)+1j*rng.normal(size=N))

        z = z + (intrinsic + coupling_term + noise_term) * DT
        power[t] = np.abs(z)**2

    return power, brain_ts

# ============================================================
# ENERGY (STRICT MEDIATOR ONLY)
# ============================================================

def energy_process(brain_ts, body, decay=0.02):

    E = 1.0
    out = []

    for t in range(STEPS):

        prod = 0.4 + 0.2 * body[t]
        cons = 0.05 * brain_ts[t]

        dE = prod - cons - decay * E
        E = max(E + dE * DT, 0)

        out.append(E)

    return np.array(out)

# ============================================================
# COGNITION (INDEPENDENT LATENT GENERATOR)
# ============================================================

def cognition_process(seed):

    rng = np.random.default_rng(seed)
    x = 0
    out = []

    for _ in range(STEPS):
        x = 0.97*x + rng.normal(0, 0.2)
        out.append(x)

    return np.array(out)

def cognition_scalar(series):
    return np.mean(series) + np.std(series)

# ============================================================
# FEATURES (NO CIRCULARITY)
# ============================================================

def brain_body_coupling(brain, body):
    return np.corrcoef(brain, body)[0,1]

def active_inference_proxy(brain):
    return np.std(np.diff(brain))

# ============================================================
# SUBJECT SIMULATION
# ============================================================

def simulate_subject(job, mode="base"):

    W, net_id, seed, subj, G, noise, coupling = job

    body = body_signal(seed + subj)

    # ========================================================
    # perturbation / ablation
    # ========================================================
    if mode == "perturb":
        body = body + np.random.normal(0, 0.2, len(body))
        noise *= 1.2
        G *= np.random.uniform(0.8, 1.2)

    if mode == "ablate":
        G *= 0.2

    L = laplacian(W)

    brain_power, brain_ts = brain_sim(L, G, noise, body, coupling, seed+subj)

    energy = energy_process(brain_ts, body)

    cog = cognition_scalar(cognition_process(seed + 999 + subj))

    return {
        "NetworkID": net_id,
        "G": G,
        "Noise": noise,
        "Coupling": coupling,

        # predictors
        "BrainBody": brain_body_coupling(np.mean(brain_power, axis=1), body),
        "ActiveInference": active_inference_proxy(brain_ts),
        "NullModel": rng_global.normal(),

        # mediator
        "EnergyMean": np.mean(energy),
        "EnergyStd": np.std(energy),

        # outcome
        "Cognition": cog
    }

# ============================================================
# JOBS
# ============================================================

def create_jobs():

    jobs = []
    net_id = 0

    for N in NETWORK_SIZES:
        for i in range(N_NETWORKS_PER_SIZE):

            W = small_world(N, seed=i)

            for G in G_VALS:
                for noise in NOISE_VALS:
                    for coupling in COUPLING_VALS:

                        for seed in range(SEEDS_PER_NETWORK):
                            for subj in range(N_SUBJECTS_PER_SEED):
                                jobs.append((W, net_id, seed, subj, G, noise, coupling))

            net_id += 1

    return jobs

# ============================================================
# PERMUTATION TEST
# ============================================================

def permutation_test(df, x, y, n_perm=2000):

    obs = np.corrcoef(df[x], df[y])[0,1]
    nulls = []

    for _ in range(n_perm):

        dfp = df.copy()
        dfp[y] = dfp.groupby("NetworkID")[y].transform(np.random.permutation)

        nulls.append(np.corrcoef(dfp[x], dfp[y])[0,1])

    return obs, np.mean(nulls), np.std(nulls)

# ============================================================
# EFFECT SIZE
# ============================================================

def cohens_d(x, y):
    x = np.array(x)
    y = np.array(y)
    return (np.mean(x) - np.mean(y)) / np.sqrt((np.var(x)+np.var(y))/2)

# ============================================================
# BAYESIAN MEDIATION (PYMC)
# ============================================================

def bayesian_mediation(df):

    X = df[["BrainBody","ActiveInference","NullModel"]].values
    M = df["EnergyMean"].values
    Y = df["Cognition"].values

    with pm.Model() as model:

        beta_X = pm.Normal("beta_X", 0, 1, shape=3)
        beta_M = pm.Normal("beta_M", 0, 1)

        sigma_M = pm.Exponential("sigma_M", 1)
        sigma_Y = pm.Exponential("sigma_Y", 1)

        mu_M = pm.math.dot(X, beta_X)
        M_obs = pm.Normal("M_obs", mu_M, sigma_M, observed=M)

        mu_Y = beta_M * M
        Y_obs = pm.Normal("Y_obs", mu_Y, sigma_Y, observed=Y)

        trace = pm.sample(1000, tune=1000, chains=2, target_accept=0.9)

    return trace

