    for N in NETWORK_SIZES:



        for topology in [

            "smallworld",

            "random",

            "lattice"

        ]:



            for i in range(
                N_NETWORKS_PER_SIZE
            ):



                if topology == "smallworld":


                    W = small_world(
                        N,
                        seed=i
                    )



                elif topology == "random":


                    W = random_network(
                        N,
                        seed=i
                    )



                else:


                    W = lattice_network(
                        N
                    )



                W = normalize_connectivity(
                    W
                )



                L = graph_laplacian(
                    W
                )



                for Kb in K_BODY_VALS:


                    for Ke in K_ENERGY_VALS:



                        for seed in range(
                            SEEDS_PER_NETWORK
                        ):



                            for subject in range(
                                N_SUBJECTS_PER_SEED
                            ):



                                jobs.append(

                                    (

                                        W,

                                        L,

                                        network_counter,

                                        seed,

                                        subject,

                                        Kb,

                                        Ke

                                    )

                                )



                network_counter += 1



    return jobs

