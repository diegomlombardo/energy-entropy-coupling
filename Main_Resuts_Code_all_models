# ============================================================
# BRAIN–ENERGY DYNAMICS
# ============================================================


def simulate_brain_energy(
    L,
    G,
    noise,
    heart,
    respiration,
    decay,
    K_BODY,
    K_ENERGY,
    seed
):

    rng = np.random.default_rng(
        seed
    )


    N = L.shape[0]


    z = (
        rng.normal(size=N)
        +
        1j*rng.normal(size=N)
    )


    omega = (
        rng.uniform(
            8,
            12,
            N
        )
        *
        2*np.pi
        /
        100
    )


    E = 1


    power = np.zeros(
        (
            STEPS,
            N
        )
    )


    energy = np.zeros(
        STEPS
    )


    for t in range(STEPS):


        brain_power = np.mean(
            np.abs(z)**2
        )


        production = (
            0.4
            +
            0.15*heart[t]
            +
            0.15*respiration[t]
        )


        consumption = (
            0.05
            *
            brain_power
        )


        E += (
            production
            -
            consumption
            -
            decay*E
        ) * DT


        E = max(
            E,
            0
        )


        forcing = (
            K_BODY*heart[t]
            +
            K_BODY*respiration[t]
            +
            K_ENERGY*E
        )


        coupling = (
            -G*(L@z)
        )


        intrinsic = (
            (
                0.02
                +
                1j*omega
                -
                np.abs(z)**2
            )
            *
            z
        )


        noise_term = (
            noise
            *
            np.sqrt(DT)
            *
            (
                rng.normal(size=N)
                +
                1j*rng.normal(size=N)
            )
        )


        dz = (
            intrinsic
            +
            coupling
            +
            forcing*z
            +
            noise_term
        )


        z += dz*DT


        power[t] = np.abs(z)**2

        energy[t] = E



    return (
        power,
        energy
    )
# ============================================================
# NON-PARAMETRIC SPEARMAN METRICS
# ============================================================


def spearman_metric(
    x,
    y
):

    if (
        np.std(x) == 0
        or np.std(y) == 0
    ):
        return np.nan


    rho, _ = spearmanr(
        x,
        y
    )

    return rho




def free_energy_metric(
    power
):

    mean_power = np.mean(
        power,
        axis=1
    )

    return np.mean(
        np.diff(mean_power)**2
    )




def energy_metrics(
    E
):

    return (

        np.std(E),

        np.mean(E)

    )




def cognition_energy(
    E,
    G
):

    return (

        0.5*G

        +

        0.5*np.mean(E)

        -

        0.3*np.std(E)

    )




def cognition_independent(
    heart,
    rng
):

    return (

        np.mean(heart)

        +

        rng.normal(
            0,
            0.1
        )

    )



# ============================================================
# FULL NON-PARAMETRIC SPEARMAN BOOTSTRAP MEDIATION
# ============================================================


def spearman_bootstrap_mediation(
    X,
    M,
    Y,
    n_boot=1000,
    seed=42
):


    rng = np.random.default_rng(
        seed
    )


    X = np.asarray(X)

    M = np.asarray(M)

    Y = np.asarray(Y)



    n = len(X)


    indirect_effects = []



    for _ in range(n_boot):


        idx = rng.integers(
            0,
            n,
            n
        )


        Xb = X[idx]

        Mb = M[idx]

        Yb = Y[idx]



        # non-parametric paths

        a, _ = spearmanr(
            Xb,
            Mb
        )


        b, _ = spearmanr(
            Mb,
            Yb
        )



        indirect = (
            a*b
        )


        indirect_effects.append(
            indirect
        )



    indirect_effects = np.asarray(
        indirect_effects
    )



    return {


        "indirect_mean":
            np.mean(
                indirect_effects
            ),


        "CI_lower_2.5":
            np.percentile(
                indirect_effects,
                2.5
            ),


        "CI_upper_97.5":
            np.percentile(
                indirect_effects,
                97.5
            ),


        "bootstrap_std":
            np.std(
                indirect_effects
            )

    }




