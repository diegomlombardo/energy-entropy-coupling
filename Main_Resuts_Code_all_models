def simulate_subject(
    job
):


    (
        W,
        L,
        network_id,
        seed,
        subject,
        K_BODY,
        K_ENERGY

    ) = job




    rng = np.random.default_rng(
        seed*100000 + subject
    )



    age = rng.uniform(
        20,
        80
    )



    G, noise, decay = age_modulation(
        age,
        rng
    )



    heart, respiration = simulate_body(
        seed + subject
    )



    power, E = simulate_brain_energy(
        L,
        G,
        noise,
        heart,
        respiration,
        decay,
        K_BODY,
        K_ENERGY,
        seed + subject
    )



    brain = np.mean(
        power,
        axis=1
    )




    # -------------------------------
    # Spearman coupling
    # -------------------------------


    brain_heart = spearman_metric(
        brain,
        heart
    )


    brain_resp = spearman_metric(
        brain,
        respiration
    )


    heart_resp = spearman_metric(
        heart,
        respiration
    )



    brain_body_model = np.sqrt(

        (

            brain_heart**2

            +

            brain_resp**2

            +

            heart_resp**2

        )

        /

        3

    )



    active_inference = free_energy_metric(
        power
    )



    energy_std, energy_mean = energy_metrics(
        E
    )



    cog_energy = cognition_energy(
        E,
        G
    )



    cog_independent = cognition_independent(
        heart,
        rng
    )



    return {


        "NetworkID":
            network_id,


        "Seed":
            seed,


        "Subject":
            subject,


        "Age":
            age,



        "BrainHeart_Spearman":
            brain_heart,


        "BrainResp_Spearman":
            brain_resp,


        "HeartResp_Spearman":
            heart_resp,



        "BrainBody_Spearman_Model":
            brain_body_model,



        "ActiveInference":
            active_inference,



        "EnergyEfficiency":
            energy_mean,



        "EnergyVariability":
            energy_std,



        "CogEnergy":
            cog_energy,



        "CogIndependent":
            cog_independent

    }




