        "CogIndependent"


    ]



    permutation_results = []



    rng = np.random.default_rng(
        GLOBAL_SEED
    )



    for target in targets:



        y = df[target].values



        for predictor in predictors:



            x = df[predictor].values




            observed_rho, _ = spearmanr(
                x,
                y
            )



            null_distribution = []



            for _ in range(
                N_PERM
            ):



                y_shuffle = rng.permutation(
                    y
                )



                rho_null, _ = spearmanr(
                    x,
                    y_shuffle
                )



                null_distribution.append(
                    rho_null
                )



            null_distribution = np.asarray(
                null_distribution
            )



            p_value = np.mean(

                np.abs(null_distribution)

                >=

                np.abs(observed_rho)

            )



            permutation_results.append(

                {


                    "Predictor":
                        predictor,


                    "Target":
                        target,


                    "Spearman_rho":
                        observed_rho,


                    "Permutation_p":
                        p_value

                }

            )



            print(

