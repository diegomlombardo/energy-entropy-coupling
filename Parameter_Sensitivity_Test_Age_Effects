def permutation_pvalue_fast(
    X,
    M,
    Y,
    n_perm,
    seed
):

    X = np.asarray(
        X,
        dtype=float
    )

    M = np.asarray(
        M,
        dtype=float
    )

    Y = np.asarray(
        Y,
        dtype=float
    )

    valid = (
        np.isfinite(X)
        & np.isfinite(M)
        & np.isfinite(Y)
    )

    X = X[valid]
    M = M[valid]
    Y = Y[valid]

    if len(X) < 5:
        return np.nan

    observed = mediation_effect(
        X,
        M,
        Y
    )

    if not np.isfinite(
        observed
    ):
        return np.nan

    rng = np.random.default_rng(
        seed
    )

    count = 0

    for _ in range(
        n_perm
    ):

        Y_perm = rng.permutation(
            Y
        )

        null_effect = mediation_effect(
            X,
            M,
            Y_perm
        )

        if (
            np.isfinite(null_effect)
            and abs(null_effect)
            >= abs(observed)
        ):
            count += 1

    return float(
        (count + 1)
        / (n_perm + 1)
    )


# ================================================================
# 15. AGE-BIN MEDIATION CURVE
# ================================================================

def age_mediation_curve(
    data,
    predictor
):

    work = data.copy()

    work["Age_bin"] = pd.cut(
        work["Age"],
        bins=AGE_BINS,
        include_lowest=True
    )

    rows = []

    for age_bin, group in work.groupby(
        "Age_bin",
        observed=False
    ):

        if len(group) < 5:
            continue

        age_mid = float(
            age_bin.mid
        )

        real = bootstrap_mediation_fast(
            group[predictor].values,
            group["EnergyEfficiency"].values,
            group["CogEnergy"].values,
            n_boot=N_BOOT_MEDIATION,
            seed=(
                SEED_GLOBAL
                + int(age_mid * 10)
            )
        )

        null_effect = mediation_effect(
            group["NullModel"].values,
            group["EnergyEfficiency"].values,
            group["CogEnergy"].values
        )

        p = permutation_pvalue_fast(
            group[predictor].values,
            group["EnergyEfficiency"].values,
            group["CogEnergy"].values,
            n_perm=N_PERMUTATIONS,
            seed=(
                SEED_GLOBAL
                + 10000
                + int(age_mid * 10)
            )
        )

        rows.append({

            "Age":
                age_mid,

            "Predictor":
                predictor,

            "Mean":
                real["indirect_mean"],

            "CI_low":
                real["ci_lower"],

            "CI_high":
                real["ci_upper"],

            "NullMean":
                null_effect,

            "p":
                p,

            "N":
                len(group),
        })

    curve = pd.DataFrame(
        rows
    )

    if curve.empty:
        return curve

    curve["p_FDR"] = np.nan

    curve["Significant"] = False

    finite = curve[
        "p"
    ].notna()

    if finite.any():

        reject, p_adj, _, _ = (
            multipletests(
                curve.loc[
                    finite,
                    "p"
                ].values,

                alpha=0.05,

                method="fdr_bh"
            )
        )

        curve.loc[
            finite,
            "p_FDR"
        ] = p_adj

        curve.loc[
            finite,
            "Significant"
        ] = reject

    curve[
        "ObservedMinusNull"
    ] = (
        curve["Mean"]
        - curve["NullMean"]
    )

    curve[
        "NegativeEffect"
    ] = (
        curve["Mean"] < 0
    )

    curve[
        "SignificantNegative"
    ] = (
        curve["Significant"]
        & curve["NegativeEffect"]
    )

    return curve


# ================================================================
# 16. MANUSCRIPT PEAK DETECTION
# ================================================================

def detect_manuscript_peak(
    curve,
    predictor
):

    if curve.empty:
        return None

    c = (
        curve
        .sort_values("Age")
        .reset_index(drop=True)
        .copy()
    )

    # ------------------------------------------------------------
    # Explicitly restrict peak search to AGE_WINDOW.
    # ------------------------------------------------------------

    c = c[
        (
            c["Age"]
            >= AGE_MIN
        )
        &
        (
            c["Age"]
            <= AGE_MAX
        )
    ].reset_index(
        drop=True
    )

    if c.empty:
        return None

    y = c[
        "Mean"
    ].to_numpy(
        dtype=float
    )

    sig = c[
        "SignificantNegative"
    ].to_numpy(
        dtype=bool
    )

    valid = (
        np.isfinite(y)
        & sig
    )

    if valid.sum() == 0:
        return None

    # ------------------------------------------------------------
    # Find local minima manually.
    # Avoid scipy.signal.find_peaks dependency.
    # ------------------------------------------------------------

    local_candidates = []

    for i in range(
        1,
        len(c) - 1
    ):

        if not valid[i]:
            continue

        left = y[i - 1]
        center = y[i]
        right = y[i + 1]

        if (
            center <= left
            and center <= right
        ):
            local_candidates.append(
                i
            )

    # If no local minimum exists, select the most negative
    # significant point.
    if local_candidates:

        idx = local_candidates[
            np.argmin(
                y[
                    local_candidates
                ]
            )
        ]

    else:

        candidates = np.where(
            valid
        )[0]

        idx = candidates[
            np.argmin(
                y[candidates]
            )
        ]

    return {

        "Age":
            float(
                c.loc[idx, "Age"]
            ),

        "Effect":
            float(
                c.loc[idx, "Mean"]
            ),

        "CI_low":
            float(
                c.loc[idx, "CI_low"]
            ),

        "CI_high":
            float(
                c.loc[idx, "CI_high"]
            ),

        "p":
            float(
                c.loc[idx, "p"]
            ),

        "p_FDR":
            float(
                c.loc[idx, "p_FDR"]
            ),

        "N":
            int(
                c.loc[idx, "N"]
            ),
    }


# ================================================================
# 17. CONDITIONS
# ================================================================

def build_conditions():

    conditions = [
        (
            "baseline",
            "BASELINE",
            np.nan,
            {}
        )
    ]

    for parameter, values in (
        SENSITIVITY_VALUES.items()
    ):

        for value in values:

            baseline = BASE_PARAMS.get(
                parameter
            )

            if (
                baseline is not None
                and np.isclose(
                    float(value),
                    float(baseline)
                )
            ):

                condition_id = (
                    f"{parameter}_baseline"
                )

            else:

                condition_id = (
                    f"{parameter}_{value}"
                )

            conditions.append(
                (
                    condition_id,
                    parameter,
                    value,
                    {
                        parameter:
                            value
                    }
                )
            )

    for parameter, values in (
        NETWORK_SENSITIVITY.items()
    ):

        if parameter == "NETWORK_SIZE":
            continue

        for value in values:

            conditions.append(
                (
                    f"{parameter}_{value}",
                    parameter,
                    value,
                    {
                        parameter:
                            value
                    }
                )
            )

    # Unique conditions.
    seen = set()
    output = []

    for condition in conditions:

        if condition[0] not in seen:

            output.append(
                condition
            )

            seen.add(
                condition[0]
            )

    return output


# ================================================================
# 18. ANALYZE CONDITION
# ================================================================

def analyze_condition(
    condition_id,
    parameter,
    value,
    overrides,
    network_sizes
):

    df = run_condition(
        condition_id,
        parameter,
        value,
        overrides,
        network_sizes
    )

    curves = []
    peaks = []

    for predictor in MANUSCRIPT_PEAKS:

        curve = age_mediation_curve(
            df,
            predictor
        )

        if not curve.empty:

            curve.insert(
                0,
                "Condition",
                condition_id
            )

            curves.append(
                curve
            )

            peak = detect_manuscript_peak(
                curve,
                predictor
            )

            if peak is not None:

                peaks.append({

                    "Condition":
                        condition_id,

                    "Parameter":
                        parameter,

                    "SensitivityValue":
                        value,

                    "Predictor":
                        predictor,

                    "Detected":
                        True,

                    "PeakAge":
                        peak["Age"],

                    "PeakEffect":
                        peak["Effect"],

                    "PeakCI_low":
                        peak["CI_low"],

                    "PeakCI_high":
                        peak["CI_high"],

                    "p":
                        peak["p"],

                    "p_FDR":
                        peak["p_FDR"],

                    "N":
                        peak["N"],
                })

        if not any(
            r["Condition"] == condition_id
            and r["Predictor"] == predictor
            for r in peaks
        ):

            peaks.append({

                "Condition":
                    condition_id,

                "Parameter":
                    parameter,

                "SensitivityValue":
                    value,

                "Predictor":
                    predictor,

                "Detected":
                    False,

                "PeakAge":
                    np.nan,

                "PeakEffect":
                    np.nan,

                "PeakCI_low":
                    np.nan,

                "PeakCI_high":
                    np.nan,

                "p":
                    np.nan,

                "p_FDR":
                    np.nan,

                "N":
                    np.nan,
            })

    if curves:

        curve_df = pd.concat(
            curves,
            ignore_index=True
        )

    else:

        curve_df = pd.DataFrame()

    return (
        df,
        curve_df,
        pd.DataFrame(peaks)
    )


