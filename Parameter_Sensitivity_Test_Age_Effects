def plot_baseline(
    curves
):

    base = curves[
        curves["Condition"]
        == "baseline"
    ]

    if base.empty:
        return

    fig, ax = plt.subplots(
        figsize=(10, 6)
    )

    for predictor in (
        MANUSCRIPT_PEAKS
    ):

        c = base[
            base["Predictor"]
            == predictor
        ].sort_values(
            "Age"
        )

        if c.empty:
            continue

        ax.plot(
            c["Age"],
            c["Mean"],
            linewidth=2.5,
            label=predictor
        )

        ax.fill_between(
            c["Age"],
            c["CI_low"],
            c["CI_high"],
            alpha=0.20
        )

        ax.scatter(
            c.loc[
                c[
                    "SignificantNegative"
                ],
                "Age"
            ],

            c.loc[
                c[
                    "SignificantNegative"
                ],
                "Mean"
            ],

            s=35
        )

        ax.axvline(
            MANUSCRIPT_PEAKS[
                predictor
            ],
            linestyle="--",
            alpha=0.5
        )

    ax.axhline(
        0,
        linewidth=1
    )

    ax.set_xlim(
        AGE_MIN,
        AGE_MAX
    )

    ax.set_xlabel(
        "Age (years)"
    )

    ax.set_ylabel(
        "Indirect mediation effect"
    )

    ax.set_title(
        "Baseline mediation curves "
        f"({AGE_MIN:.0f}-{AGE_MAX:.0f} years)"
    )

    ax.legend(
        frameon=False
    )

    fig.tight_layout()

    fig.savefig(
        os.path.join(
            FIG_DIR,
            "baseline_peak_claims.png"
        ),
        dpi=400
    )

    plt.close(fig)


