# 7. BODY SIMULATION
# ================================================================

def simulate_body(
    seed,
    params
):

    rng = np.random.default_rng(seed)

    phase = 0.0

    heart = np.zeros(
        params["STEPS"],
        dtype=np.float32
    )

    phase_increment = (
        2.0
        * np.pi
        * params["HEART_FREQ"]
        * params["DT"]
    )

    for t in range(
        params["STEPS"]
    ):

        phase += (
            phase_increment
            + rng.normal(
                0.0,
                params["HEART_PHASE_NOISE"]
            )
        )

        heart[t] = np.sin(
            phase
        )

    return heart


# ================================================================
# 8. AGE MODULATION
# ================================================================

def age_modulation(
    age,
    rng,
    params
):

    G = (

        params["G_AMPLITUDE"]

        * np.exp(
            -(
                (
                    age
                    - params["G_PEAK_AGE"]
                )
                / params["G_WIDTH"]
            ) ** 2
        )

        + rng.normal(
            0.0,
            params["G_NOISE_SD"]
        )
    )

    noise = (

        params["NOISE_BASE"]

        + params["NOISE_AGE_SLOPE"]
        * age

        + rng.normal(
            0.0,
            params["NOISE_RANDOM_SD"]
        )
    )

    noise = max(
        noise,
        0.0
    )

    decay = (

        params["DECAY_BASE"]

        + params["DECAY_AGE_SLOPE"]
        * age
    )

    return (
        G,
        noise,
        decay
    )


# ================================================================
# 9. BRAIN / ENERGY SIMULATION
# ================================================================

def simulate_brain_energy(
    L,
    G,
    noise,
    heart,
    decay,
    params,
    seed
):

    rng = np.random.default_rng(
        seed
    )

    N = L.shape[0]

    steps = params["STEPS"]
    dt = params["DT"]

    z = (
        rng.normal(
            size=N
        )
        + 1j * rng.normal(
            size=N
        )
    ).astype(
        np.complex64
    )

    omega = rng.uniform(
        params["OMEGA_LOW"],
        params["OMEGA_HIGH"],
        N
    ).astype(
        np.float32
    )

    omega *= (
        2.0
        * np.pi
        / 100.0
    )

    E = 1.0

    power = np.zeros(
        (steps, N),
        dtype=np.float32
    )

    energy = np.zeros(
        steps,
        dtype=np.float32
    )

    coupling_scale = (
        params["COUPLING_SCALE"]
        * G
    )

    for t in range(steps):

        brain_power = float(
            np.mean(
                np.abs(z) ** 2
            )
        )

        prod = (

            params[
                "ENERGY_PRODUCTION_BASE"
            ]

            + params[
                "ENERGY_PRODUCTION_HEART"
            ]
            * heart[t]
        )

        cons = (
            params[
                "ENERGY_CONSUMPTION"
            ]
            * brain_power
        )

        dE = (
            prod
            - cons
            - decay * E
        )

        E = max(
            E + dE * dt,
            0.0
        )

        forcing = (

            params["K_BODY"]
            * heart[t]

            + params["K_ENERGY"]
            * E
        )

        coupling = (
            -coupling_scale
            * (L @ z)
        )

        intrinsic = (

            params[
                "INTRINSIC_GROWTH"
            ]

            + 1j * omega

            - np.abs(z) ** 2
        ) * z

        noise_term = (

            noise
            * np.sqrt(dt)

            * (
                rng.normal(
                    size=N
                )

                + 1j
                * rng.normal(
                    size=N
                )
            )
        )

        dz = (

            intrinsic
            + coupling
            + forcing * z
            + noise_term
        )

        z += (
            dz * dt
        ).astype(
            np.complex64
        )

        power[t] = (
            np.abs(z) ** 2
        )

        energy[t] = E

    return (
        power,
        energy
    )


# ================================================================
# 10. METRICS
# ================================================================

def coherence(
    sig1,
    sig2
):

    phase1 = np.angle(
        sig1
    )

    phase2 = np.angle(
        sig2
    )

    return float(
        np.abs(
            np.mean(
                np.exp(
                    1j
                    * (
                        phase1
                        - phase2
                    )
                )
            )
        )
    )


def energy_metrics(E):

    return (
        float(np.std(E)),
        float(np.mean(E))
    )


def cognition_energy(
    E,
    G,
    params
):

    return float(

        params[
            "COG_G_WEIGHT"
        ] * G

        + params[
            "COG_E_WEIGHT"
        ] * np.mean(E)

        - params[
            "COG_STABILITY_PENALTY"
        ] * np.std(E)
    )


def cognition_independent(
    heart,
    rng,
    params
):

    return float(

        np.mean(heart)

        + rng.normal(
            0.0,
            params[
                "COG_INDEPENDENT_NOISE"
            ]
        )
    )


def free_energy_metric(
    power
):

    pred = np.mean(
        power,
        axis=1
    )

    return float(
        np.mean(
            np.diff(pred) ** 2
        )
    )


