# ================================================================
# 20. MANUSCRIPT-LEVEL SUMMARY
# ================================================================

def summarize_manuscript_peak(
    peaks
):

    rows = []

    for (
        predictor,
        reported_age
    ) in MANUSCRIPT_PEAKS.items():

        sub = peaks[
            peaks["Predictor"]
            == predictor
        ].copy()

        total = len(sub)

        detected = sub[
            sub["Detected"]
        ].copy()

        if detected.empty:

            rows.append({

                "Predictor":
                    predictor,

                "ManuscriptPeakAge":
                    reported_age,

                "AgeWindowMin":
                    AGE_MIN,

                "AgeWindowMax":
                    AGE_MAX,

                "N_conditions":
                    total,

                "N_detected":
                    0,

                "DetectionRate":
                    0.0,

                "N_within_5y":
                    0,

                "MatchRate_5y":
                    0.0,

                "MedianPeakAge":
                    np.nan,

                "PeakAge95CI_low":
                    np.nan,

                "PeakAge95CI_high":
                    np.nan,

                "MedianAbsoluteShift":
                    np.nan,

                "MaxAbsoluteShift":
                    np.nan,

                "Status":
                    "NOT SUPPORTED",
            })

            continue

        shifts = np.abs(
            detected["PeakAge"]
            - reported_age
        )

        within = (
            shifts
            <= PEAK_MATCH_YEARS
        )

        detection_rate = (
            len(detected)
            / max(total, 1)
        )

        match_rate = (
            within.mean()
        )

        median_age = float(
            np.median(
                detected["PeakAge"]
            )
        )

        ci_low, ci_high = (
            np.percentile(
                detected["PeakAge"],
                [2.5, 97.5]
            )
        )

        median_shift = float(
            np.median(shifts)
        )

        max_shift = float(
            np.max(shifts)
        )

        if (
            detection_rate
            >= ROBUST_DETECTION_RATE
            and median_shift
            <= ROBUST_MEDIAN_SHIFT_YEARS
        ):

            status = "CONFIRMED"

        elif (
            detection_rate
            >= MODERATE_DETECTION_RATE
            and median_shift
            <= MODERATE_MEDIAN_SHIFT_YEARS
        ):

            status = "MODERATELY SUPPORTED"

        else:

            status = "NOT SUPPORTED"

        rows.append({

            "Predictor":
                predictor,

            "ManuscriptPeakAge":
                reported_age,

            "AgeWindowMin":
                AGE_MIN,

            "AgeWindowMax":
                AGE_MAX,

            "N_conditions":
                total,

            "N_detected":
                len(detected),

            "DetectionRate":
                detection_rate,

            "N_within_5y":
                int(
                    within.sum()
                ),

            "MatchRate_5y":
                float(
                    match_rate
                ),

            "MedianPeakAge":
                median_age,

            "PeakAge95CI_low":
                float(
                    ci_low
                ),

            "PeakAge95CI_high":
                float(
                    ci_high
                ),

            "MedianAbsoluteShift":
                median_shift,

            "MaxAbsoluteShift":
                max_shift,

            "Status":
                status,
        })

    return pd.DataFrame(
        rows
    )


# ================================================================
# 21. CONDITION-LEVEL RESULTS
# ================================================================

def condition_level_results(
    peaks
):

    rows = []

    for _, r in peaks.iterrows():

        predictor = r[
            "Predictor"
        ]

        reported = (
            MANUSCRIPT_PEAKS[
                predictor
            ]
        )

        if bool(
            r["Detected"]
        ):

            shift = (
                float(
                    r["PeakAge"]
                    - reported
                )
            )

            abs_shift = abs(
                shift
            )

            within = (
                abs_shift
                <= PEAK_MATCH_YEARS
            )

        else:

            shift = np.nan
            abs_shift = np.nan
            within = False

        rows.append({

            **r.to_dict(),

            "ManuscriptPeakAge":
                reported,

            "PeakAgeShift":
                shift,

            "AbsolutePeakAgeShift":
                abs_shift,

            "Within5Years":
                within,
        })

    return pd.DataFrame(
        rows
    )


# ================================================================
# 22. PARAMETER SUMMARY
# ================================================================

def summarize_by_parameter(
    condition_results
):

    rows = []

    for (
        predictor,
        parameter
    ), g in condition_results.groupby(
        [
            "Predictor",
            "Parameter"
        ],
        dropna=False
    ):

        detected = g[
            g["Detected"]
        ]

        shifts = (
            detected[
                "AbsolutePeakAgeShift"
            ]
            .dropna()
        )

        if len(detected):

            detection = (
                len(detected)
                / len(g)
            )

            within = (
                detected[
                    "Within5Years"
                ].mean()
            )

        else:

            detection = 0.0
            within = 0.0

        if len(shifts):

            median_shift = (
                shifts.median()
            )

            max_shift = (
                shifts.max()
            )

            worst_idx = (
                shifts.idxmax()
            )

            worst_condition = (
                g.loc[
                    worst_idx,
                    "Condition"
                ]
            )

        else:

            median_shift = np.nan
            max_shift = np.nan
            worst_condition = ""

        rows.append({

            "Predictor":
                predictor,

            "Parameter":
                parameter,

            "N_conditions":
                len(g),

            "DetectionRate":
                detection,

            "MatchRate_5y":
                within,

            "MedianAbsoluteShift":
                median_shift,

            "MaxAbsoluteShift":
                max_shift,

            "WorstCondition":
                worst_condition,
        })

    return pd.DataFrame(
        rows
    )


