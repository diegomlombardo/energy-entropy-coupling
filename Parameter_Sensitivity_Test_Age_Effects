def small_world(
    N,
    k=6,
    p=0.2,
    seed=None
):

    rng = np.random.default_rng(seed)

    W = np.zeros(
        (N, N),
        dtype=np.float32
    )

    for i in range(N):

        for j in range(
            1,
            k // 2 + 1
        ):

            W[
                i,
                (i + j) % N
            ] = 1.0

            W[
                i,
                (i - j) % N
            ] = 1.0

    for i in range(N):

        for j in range(N):

            if (
                W[i, j] == 1.0
                and rng.random() < p
            ):

                W[i, j] = 0.0

                new = int(
                    rng.integers(N)
                )

                guard = 0

                while (
                    (
                        new == i
                        or W[i, new] == 1.0
                    )
                    and guard < 1000
                ):

                    new = int(
                        rng.integers(N)
                    )

                    guard += 1

                if new != i:
                    W[i, new] = 1.0

    W = (
        W + W.T
    ) / 2.0

    np.fill_diagonal(
        W,
        0.0
    )

    return W


def random_network(
    N,
    threshold=0.90,
    seed=None
):

    rng = np.random.default_rng(seed)

    W = rng.random(
        (N, N)
    ).astype(np.float32)

    W = (
        W + W.T
    ) / 2.0

    W[
        W < threshold
    ] = 0.0

    np.fill_diagonal(
        W,
        0.0
    )

    return W


def lattice_network(
    N,
    k=6
):

    W = np.zeros(
        (N, N),
        dtype=np.float32
    )

    for i in range(N):

        for j in range(
            1,
            k // 2 + 1
        ):

            W[
                i,
                (i + j) % N
            ] = 1.0

            W[
                i,
                (i - j) % N
            ] = 1.0

    return W


def normalize_connectivity(W):

    eig = np.linalg.eigvals(W)

    maximum = float(
        np.max(
            np.abs(eig)
        )
    )

    if maximum == 0:
        return W

    return (
        W / maximum
    ).astype(np.float32)


def graph_laplacian(W):

    degree = W.sum(
        axis=1
    )

    return (
        np.diag(degree)
        - W
    ).astype(np.float32)


def create_networks(
    params,
    network_sizes
):

    networks = []

    net_counter = 0

    for N in network_sizes:

        for topology in (
            "smallworld",
            "random",
            "lattice"
        ):

            for rep in range(
                N_NETWORKS_RUN
            ):

                if topology == "smallworld":

                    W = small_world(
                        N,
                        int(params["SW_K"]),
                        params["SW_P"],
                        seed=rep
                    )

                elif topology == "random":

                    W = random_network(
                        N,
                        params["RANDOM_THRESHOLD"],
                        seed=rep
                    )

                else:

                    W = lattice_network(
                        N,
                        int(params["SW_K"])
                    )

                W = normalize_connectivity(W)

                L = graph_laplacian(W)

                networks.append(
                    (
                        W,
                        L,
                        net_counter,
                        N,
                        topology,
                        rep
                    )
                )

                net_counter += 1

    return networks


