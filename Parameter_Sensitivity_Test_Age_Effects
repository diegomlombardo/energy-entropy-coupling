def simulate_subject(
    job
):

    (
        W,
        L,
        net_id,
        network_size,
        topology,
        network_rep,
        seed,
        subj,
        params,
        condition_id,
        sensitivity_parameter,
        sensitivity_value
    ) = job

    subject_seed = int(
        seed * 100000
        + subj
        + 1000 * net_id
    )

    rng = np.random.default_rng(
        subject_seed
    )

    # ------------------------------------------------------------
    # IMPORTANT:
    # Generate age ONLY inside the requested window.
    # ------------------------------------------------------------

    age = float(
        rng.uniform(
            AGE_MIN,
            AGE_MAX
        )
    )

    G, noise, decay = age_modulation(
        age,
        rng,
        params
    )

    heart = simulate_body(
        seed + subj,
        params
    )

    power, E = simulate_brain_energy(
        L,
        G,
        noise,
        heart,
        decay,
        params,
        seed + subj
    )

    brain = np.mean(
        power,
        axis=1
    )

    brain_body = coherence(
        brain,
        heart
    )

    active_inference = (
        free_energy_metric(
            power
        )
    )

    null_model = float(
        rng.normal()
    )

    stab, eff = energy_metrics(
        E
    )

    cog_energy = cognition_energy(
        E,
        G,
        params
    )

    cog_indep = cognition_independent(
        heart,
        rng,
        params
    )

    return {

        "Condition":
            condition_id,

        "SensitivityParameter":
            sensitivity_parameter,

        "SensitivityValue":
            sensitivity_value,

        "NetworkID":
            net_id,

        "NetworkSize":
            network_size,

        "Topology":
            topology,

        "NetworkRep":
            network_rep,

        "Seed":
            seed,

        "Subject":
            subj,

        "Age":
            age,

        "G":
            G,

        "Noise":
            noise,

        "Decay":
            decay,

        "BrainBody":
            brain_body,

        "ActiveInference":
            active_inference,

        "NullModel":
            null_model,

        "EnergyStability":
            stab,

        "EnergyEfficiency":
            eff,

        "CogEnergy":
            cog_energy,

        "CogIndependent":
            cog_indep,
    }


# ================================================================
# 12. JOB CREATION
# ================================================================

def create_jobs(
    params,
    condition_id,
    sensitivity_parameter,
    sensitivity_value,
    network_sizes
):

    networks = create_networks(
        params,
        network_sizes
    )

    jobs = []

    for (
        W,
        L,
        net_id,
        N,
        topology,
        rep
    ) in networks:

        for seed in range(
            SEEDS_RUN
        ):

            for subj in range(
                SUBJECTS_RUN
            ):

                jobs.append(
                    (
                        W,
                        L,
                        net_id,
                        N,
                        topology,
                        rep,
                        seed,
                        subj,
                        params,
                        condition_id,
                        sensitivity_parameter,
                        sensitivity_value
                    )
                )

    return jobs


def run_condition(
    condition_id,
    parameter,
    value,
    overrides,
    network_sizes
):

    params = prepare_params(
        overrides
    )

    jobs = create_jobs(
        params,
        condition_id,
        parameter,
        value,
        network_sizes
    )

    print(
        f"Running "
        f"{condition_id:>28s} "
        f"| jobs={len(jobs):,}"
    )

    results = Parallel(
        n_jobs=N_CORES,
        backend="loky",
        verbose=0
    )(
        delayed(
            simulate_subject
        )(job)

        for job in jobs
    )

    return pd.DataFrame(
        results
    )


# ================================================================
# 13. FAST MEDIATION
# ================================================================
#
# Instead of:
#
#   bootstrap
#       inside permutation
#           inside age bin
#               inside sensitivity condition
#
# we calculate the mediation effect directly and bootstrap it only
# when required.
#
# This is one of the largest speed improvements.
# ================================================================

def mediation_effect(
    X,
    M,
    Y
):

    X = np.asarray(
        X,
        dtype=float
    )

    M = np.asarray(
        M,
        dtype=float
    )

    Y = np.asarray(
        Y,
        dtype=float
    )

    valid = (
        np.isfinite(X)
        & np.isfinite(M)
        & np.isfinite(Y)
    )

    X = X[valid]
    M = M[valid]
    Y = Y[valid]

    if len(X) < 5:
        return np.nan

    X1 = np.column_stack(
        [
            np.ones(len(X)),
            X
        ]
    )

    a = np.linalg.lstsq(
        X1,
        M,
        rcond=None
    )[0][1]

    XM = np.column_stack(
        [
            np.ones(len(X)),
            X,
            M
        ]
    )

    b = np.linalg.lstsq(
        XM,
        Y,
        rcond=None
    )[0][2]

    return float(
        a * b
    )


def bootstrap_mediation_fast(
    X,
    M,
    Y,
    n_boot,
    seed
):

    X = np.asarray(
        X,
        dtype=float
    )

    M = np.asarray(
        M,
        dtype=float
    )

    Y = np.asarray(
        Y,
        dtype=float
    )

    valid = (
        np.isfinite(X)
        & np.isfinite(M)
        & np.isfinite(Y)
    )

    X = X[valid]
    M = M[valid]
    Y = Y[valid]

    n = len(X)

    if n < 5:
        return {
            "indirect_mean": np.nan,
            "ci_lower": np.nan,
            "ci_upper": np.nan
        }

    rng = np.random.default_rng(
        seed
    )

    effects = np.empty(
        n_boot,
        dtype=float
    )

    for i in range(
        n_boot
    ):

        idx = rng.integers(
            0,
            n,
            n
        )

        effects[i] = mediation_effect(
            X[idx],
            M[idx],
            Y[idx]
        )

    effects = effects[
        np.isfinite(effects)
    ]

    if len(effects) == 0:
        return {
            "indirect_mean": np.nan,
            "ci_lower": np.nan,
            "ci_upper": np.nan
        }

    return {

        "indirect_mean":
            float(
                np.mean(effects)
            ),

        "ci_lower":
            float(
                np.percentile(
                    effects,
                    2.5
                )
            ),

        "ci_upper":
            float(
                np.percentile(
                    effects,
                    97.5
                )
            ),
    }


