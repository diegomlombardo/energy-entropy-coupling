# ================================================================
# 12. FORMAT COMPACT TABLE FOR PUBLICATION
# ================================================================

def format_publication_table(
    compact,
    markdown=False
):

    table = compact.copy()


    # ------------------------------------------------------------
    # Create compact Peak label.
    #
    # The manuscript peak age is placed directly in the Peak
    # column and will be bold in Markdown.
    # ------------------------------------------------------------

    if markdown:

        table["Peak"] = table.apply(

            lambda row:

            (
                f"**{row['Peak']} "
                f"({row['Reference peak (y)']:.1f} y)**"
            ),

            axis=1

        )

    else:

        table["Peak"] = table.apply(

            lambda row:

            (
                f"{row['Peak']} "
                f"({row['Reference peak (y)']:.1f} y)"
            ),

            axis=1

        )


    # ------------------------------------------------------------
    # Percentages
    # ------------------------------------------------------------

    for column in [

        "Detected",
        "Within ±5 y",
        "FDR",

    ]:

        table[column] = table[column].map(

            lambda value:

            f"{value:.0%}"

            if pd.notna(value)

            else "NA"

        )


    # ------------------------------------------------------------
    # Tested range
    # ------------------------------------------------------------

    table["Tested range"] = (

        table["Tested range"]
        .fillna("NA")
        .astype(str)

    )


    # ------------------------------------------------------------
    # N values
    # ------------------------------------------------------------

    table["N values"] = table["N values"].map(

        lambda value:

        f"{int(value)}"

        if pd.notna(value)

        else "NA"

    )


    # ------------------------------------------------------------
    # Peak range
    # ------------------------------------------------------------

    def format_peak_range(row):

        low = row["Peak range min"]

        high = row["Peak range max"]


        if pd.isna(low) or pd.isna(high):

            return "NA"


        return (
            f"{low:.1f}–{high:.1f}"
        )


    table["Peak range (y)"] = table.apply(

        format_peak_range,

        axis=1

    )


    # ------------------------------------------------------------
    # Maximum displacement
    # ------------------------------------------------------------

    table["Max Δ (y)"] = (

        table["Max Δ (y)"]

        .map(

            lambda value:

            f"{value:.1f}"

            if pd.notna(value)

            else "NA"

        )

    )


    # ------------------------------------------------------------
    # Remove intermediate columns
    # ------------------------------------------------------------

    table = table[

        [

            "Peak",

            "Parameter",

            "Tested range",

            "N values",

            "Detected",

            "Within ±5 y",

            "FDR",

            "Peak range (y)",

            "Max Δ (y)",

        ]

    ]


    return table


# ================================================================
# 13. CREATE RANKED SENSITIVITY TABLE
# ================================================================

def rank_parameter_sensitivity(
    full_table
):

    ranked = full_table.copy()


    # Lower robustness = greater sensitivity.
    # Greater maximum displacement = greater sensitivity.

    ranked["Sensitivity_rank"] = (

        ranked.groupby("Peak")[
            "Robust_rate"
        ]

        .rank(

            ascending=True,

            method="min"

        )

    )


    ranked = ranked.sort_values(

        [

            "Peak",
            "Robust_rate",
            "Maximum_absolute_shift",

        ],

        ascending=[

            True,
            True,
            False,

        ]

    )


    return ranked


