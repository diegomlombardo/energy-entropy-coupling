# 19. WRITE REVIEWER SUMMARY
# ================================================================

def write_reviewer_summary(
    full_table
):

    output = os.path.join(

        OUTPUT_DIR,

        "Reviewer_peak_robustness_summary.txt"

    )


    lines = []


    lines.append(
        "ROBUSTNESS OF REPORTED PEAK AGES TO PARAMETER VARIATION"
    )

    lines.append(
        "=" * 70
    )

    lines.append("")


    for predictor in MANUSCRIPT_PEAKS:

        peak_name = predictor_name(
            predictor
        )


        sub = full_table[
            full_table["Peak"]
            == peak_name
        ].copy()


        if sub.empty:

            continue


        lines.append(
            peak_name
        )

        lines.append(
            "-" * len(peak_name)
        )


        lines.append(

            f"Reference peak: "
            f"{MANUSCRIPT_PEAKS[predictor]:.1f} years"

        )


        lines.append("")


        # --------------------------------------------------------
        # Most robust parameters
        # --------------------------------------------------------

        best = sub.sort_values(

            [

                "Robust_rate",
                "Maximum_absolute_shift",

            ],

            ascending=[

                False,
                True,

            ]

        ).head(5)


        lines.append(
            "Most robust parameters:"
        )


        for _, row in best.iterrows():

            lines.append(

                f"  {row['Parameter']}: "
                f"{row['Robust_rate']:.0%} robust; "
                f"maximum |shift| = "
                f"{row['Maximum_absolute_shift']:.2f} y"

            )


        lines.append("")


        # --------------------------------------------------------
        # Most influential parameters
        # --------------------------------------------------------

        worst = sub.sort_values(

            [

                "Robust_rate",
                "Maximum_absolute_shift",

            ],

            ascending=[

                True,
                False,

            ]

        ).head(5)


        lines.append(
            "Parameters with greatest influence:"
        )


        for _, row in worst.iterrows():

            lines.append(

                f"  {row['Parameter']}: "
                f"{row['Robust_rate']:.0%} robust; "
                f"maximum |shift| = "
                f"{row['Maximum_absolute_shift']:.2f} y; "
                f"classification = "
                f"{row['Robustness']}"

            )


        lines.append("")


        # --------------------------------------------------------
        # Overall interpretation
        # --------------------------------------------------------

        overall_robustness = (

            sub["Robust_rate"]
            .median()

        )


        maximum_shift = (

            sub["Maximum_absolute_shift"]
            .max()

        )


        if overall_robustness >= 0.90:

            conclusion = (

                "The peak is highly robust across the "
                "tested parameter variations."

            )

        elif overall_robustness >= 0.70:

            conclusion = (

                "The peak is robust across most tested "
                "parameter variations, with some parameter "
                "dependence."

            )

        else:

            conclusion = (

                "The peak shows appreciable parameter "
                "dependence."

            )


        lines.append(
            "Overall interpretation:"
        )

        lines.append(
            f"  {conclusion}"
        )

        lines.append(

            f"  Median parameter-level robustness: "
            f"{overall_robustness:.0%}"

        )

        lines.append(

            f"  Largest observed peak displacement: "
            f"{maximum_shift:.2f} years"

        )

        lines.append("")


    with open(

        output,

        "w",

        encoding="utf-8"

    ) as file:

        file.write(
            "\n".join(lines)
        )


    print()
    print(
        "Reviewer interpretation:"
    )

    print(
        os.path.abspath(
            output
        )
    )


