# ------------------------------------------------
# Manuscript peak locations
# ------------------------------------------------
#
# These are the peak ages reported in the main
# manuscript.
#
# They are deliberately displayed in bold in the
# compact publication table.
# ------------------------------------------------

MANUSCRIPT_PEAKS = {

    "BrainBody": 57.5,

    "PredictiveModel": 22.5,

}


# ------------------------------------------------
# Peak matching criterion
# ------------------------------------------------

MATCH_WINDOW = 5.0


# ------------------------------------------------
# FDR criterion
# ------------------------------------------------

FDR_THRESHOLD = 0.05


# ------------------------------------------------
# Descriptive robustness thresholds
# ------------------------------------------------

HIGH_ROBUSTNESS = 0.90

MODERATE_ROBUSTNESS = 0.70

LOW_ROBUSTNESS = 0.50


# ================================================================
# 3. DISPLAY NAMES
