# ================================================================
# 6. PREPARE DATA
# ================================================================

def prepare_data(df):

    df = df.copy()


    # ------------------------------------------------------------
    # Standardize predictor names
    # ------------------------------------------------------------

    df["Predictor"] = (

        df["Predictor"]
        .astype(str)
        .str.strip()

        .replace({

            "ActiveInference":
                "PredictiveModel",

            "Active Inference":
                "PredictiveModel",

            "Predictive Model":
                "PredictiveModel",

        })

    )


    # ------------------------------------------------------------
    # Standardize parameter names
    # ------------------------------------------------------------

    df["Parameter"] = (

        df["Parameter"]
        .astype(str)
        .str.strip()

    )


    # ------------------------------------------------------------
    # Numeric columns
    # ------------------------------------------------------------

    numeric_columns = [

        "PeakAge",
        "ManuscriptPeakAge",
        "SensitivityValue",
        "p",
        "p_FDR",
        "PeakCI_low",
        "PeakCI_high",
        "N",

    ]

    for column in numeric_columns:

        if column in df.columns:

            df[column] = pd.to_numeric(
                df[column],
                errors="coerce"
            )


    # ------------------------------------------------------------
    # Standardize Detected
    # ------------------------------------------------------------

    if df["Detected"].dtype != bool:

        df["Detected"] = (

            df["Detected"]
            .astype(str)
            .str.strip()
            .str.lower()
            .isin({

                "true",
                "1",
                "yes",
                "y",
                "detected",
                "peak",

            })

        )


    # ------------------------------------------------------------
    # Replace manuscript peak values with the explicitly
    # defined manuscript values above.
    # ------------------------------------------------------------

    df["ManuscriptPeakAge"] = (

        df["Predictor"]
        .map(MANUSCRIPT_PEAKS)
        .fillna(
            df["ManuscriptPeakAge"]
        )

    )


    # ------------------------------------------------------------
    # Peak displacement
    # ------------------------------------------------------------

    df["PeakShift"] = (

        df["PeakAge"]
        - df["ManuscriptPeakAge"]

    )


    df["AbsolutePeakShift"] = (

        df["PeakShift"]
        .abs()

    )


    # ------------------------------------------------------------
    # Peak detected within manuscript ±5 years
    # ------------------------------------------------------------

    df["WithinWindow"] = (

        df["Detected"]

        & df["PeakAge"].notna()

        & (

            df["AbsolutePeakShift"]
            <= MATCH_WINDOW

        )

    )


    # ------------------------------------------------------------
    # FDR-supported peak
    # ------------------------------------------------------------

    df["FDRSupported"] = (

        df["Detected"]

        & df["p_FDR"].notna()

        & (

            df["p_FDR"]
            < FDR_THRESHOLD

        )

    )


    # ------------------------------------------------------------
    # Robust peak
    #
    # A robust peak is:
    #
    #   1. detected
    #   2. within ±5 years
    #   3. FDR-supported
    # ------------------------------------------------------------

    df["RobustPeak"] = (

        df["WithinWindow"]

        & df["FDRSupported"]

    )


    return df


# ================================================================
# 7. PARAMETER ORDER
# ================================================================

PREFERRED_PARAMETER_ORDER = [

    "K_BODY",
    "K_ENERGY",
    "COUPLING_SCALE",

    "G_AMPLITUDE",
    "G_PEAK_AGE",
    "G_WIDTH",

    "NOISE_BASE",
    "NOISE_AGE_SLOPE",

    "DECAY_BASE",
    "DECAY_AGE_SLOPE",

    "ENERGY_PRODUCTION_BASE",
    "ENERGY_PRODUCTION_HEART",
    "ENERGY_CONSUMPTION",

    "HEART_FREQ",
    "HEART_PHASE_NOISE",

    "INTRINSIC_GROWTH",

    "OMEGA_LOW",
    "OMEGA_HIGH",

    "DT",
    "T",

    "SW_K",
    "SW_P",

    "RANDOM_THRESHOLD",
    "NETWORK_SIZE",

]


def get_parameter_order(df):

    unique_parameters = (

        df["Parameter"]
        .dropna()
        .unique()
        .tolist()

    )


    existing = [

        parameter

        for parameter
        in PREFERRED_PARAMETER_ORDER

        if parameter in unique_parameters

    ]


    remaining = [

        parameter

        for parameter
        in unique_parameters

        if parameter not in existing

    ]


    return existing + sorted(
        remaining
    )


# ================================================================
# 8. ROBUSTNESS CLASSIFICATION
# ================================================================

def classify_robustness(rate):

    if pd.isna(rate):

        return "Not evaluable"


    if rate >= HIGH_ROBUSTNESS:

        return "Highly robust"


    if rate >= MODERATE_ROBUSTNESS:

        return "Robust"


    if rate >= LOW_ROBUSTNESS:

        return "Moderately sensitive"


    return "Sensitive"


# ================================================================
# 9. PARAMETER-LEVEL ANALYSIS
# ================================================================

def analyze_parameter(group):

    total = len(group)


    detected = group[
        group["Detected"]
    ]


    within = group[
        group["WithinWindow"]
    ]


    fdr = group[
        group["FDRSupported"]
    ]


    robust = group[
        group["RobustPeak"]
    ]


    # ------------------------------------------------------------
    # Detected peak statistics
    # ------------------------------------------------------------

    if len(detected):

        median_peak = (
            detected["PeakAge"]
            .median()
        )

        mean_peak = (
            detected["PeakAge"]
            .mean()
        )

        min_peak = (
            detected["PeakAge"]
            .min()
        )

        max_peak = (
            detected["PeakAge"]
            .max()
        )

        median_shift = (
            detected["AbsolutePeakShift"]
            .median()
        )

        mean_shift = (
            detected["AbsolutePeakShift"]
            .mean()
        )

        max_shift = (
            detected["AbsolutePeakShift"]
            .max()
        )

    else:

        median_peak = np.nan
        mean_peak = np.nan

        min_peak = np.nan
        max_peak = np.nan

        median_shift = np.nan
        mean_shift = np.nan
        max_shift = np.nan


    # ------------------------------------------------------------
    # Tested parameter values
    # ------------------------------------------------------------

    if "SensitivityValue" in group.columns:

        sensitivity_values = (

            group["SensitivityValue"]
            .dropna()
            .unique()

        )

    else:

        sensitivity_values = np.array([])


    if len(sensitivity_values):

        sensitivity_values = np.sort(
            sensitivity_values
        )

        parameter_min = (
            sensitivity_values.min()
        )

        parameter_max = (
            sensitivity_values.max()
        )

        n_parameter_values = (
            len(sensitivity_values)
        )

        parameter_range = (

            f"{parameter_min:g}–"
            f"{parameter_max:g}"

        )

    else:

        parameter_min = np.nan
        parameter_max = np.nan
        n_parameter_values = np.nan

        parameter_range = "NA"


    # ------------------------------------------------------------
    # Rates
    # ------------------------------------------------------------

    detection_rate = (

        len(detected) / total

        if total

        else np.nan

    )


    within_rate = (

        len(within) / total

        if total

        else np.nan

    )


    fdr_rate = (

        len(fdr) / total

        if total

        else np.nan

    )


    robust_rate = (

        len(robust) / total

        if total

        else np.nan

    )


    # ------------------------------------------------------------
    # Robustness classification
    # ------------------------------------------------------------

    sensitivity_class = classify_robustness(
        robust_rate
    )


    # ------------------------------------------------------------
    # Peak-location sensitivity
    # ------------------------------------------------------------

    if pd.notna(max_shift):

        if max_shift <= 2:

            location_effect = "Minimal"

        elif max_shift <= MATCH_WINDOW:

            location_effect = "Small"

        elif max_shift <= 10:

            location_effect = "Moderate"

        else:

            location_effect = "Large"

    else:

        location_effect = "Not evaluable"


    return {

        "N_conditions":
            total,

        "N_parameter_values":
            n_parameter_values,

        "Parameter_min":
            parameter_min,

        "Parameter_max":
            parameter_max,

        "Parameter_range":
            parameter_range,

        "N_detected":
            len(detected),

        "Detection_rate":
            detection_rate,

        "N_within_5y":
            len(within),

        "Within_5y_rate":
            within_rate,

        "N_FDR_supported":
            len(fdr),

        "FDR_support_rate":
            fdr_rate,

        "N_robust":
            len(robust),

        "Robust_rate":
            robust_rate,

        "Median_peak_age":
            median_peak,

        "Mean_peak_age":
            mean_peak,

        "Peak_age_min":
            min_peak,

        "Peak_age_max":
            max_peak,

        "Median_absolute_shift":
            median_shift,

        "Mean_absolute_shift":
            mean_shift,

        "Maximum_absolute_shift":
            max_shift,

        "Peak_location_effect":
            location_effect,

        "Robustness":
            sensitivity_class,

    }


# ================================================================
# 10. BUILD FULL PARAMETER TABLE
# ================================================================

def create_full_parameter_table(df):

    rows = []

    parameter_order = get_parameter_order(
        df
    )


    for predictor in MANUSCRIPT_PEAKS:

        predictor_data = df[
            df["Predictor"]
            == predictor
        ]


        for parameter in parameter_order:

            group = predictor_data[
                predictor_data["Parameter"]
                == parameter
            ]


            if group.empty:

                continue


            result = analyze_parameter(
                group
            )


            row = {

                "Peak":
                    predictor_name(
                        predictor
                    ),

                "Predictor":
                    predictor,

                "Manuscript_peak_year":
                    MANUSCRIPT_PEAKS[
                        predictor
                    ],

                "Parameter":
                    parameter,

            }


            row.update(
                result
            )


            rows.append(
                row
            )


    table = pd.DataFrame(
        rows
    )


    parameter_order_map = {

        parameter: index

        for index, parameter
        in enumerate(parameter_order)

    }


    table["_parameter_order"] = (

        table["Parameter"]
        .map(parameter_order_map)

    )


    predictor_order = {

        predictor_name(predictor):
            index

        for index, predictor
        in enumerate(MANUSCRIPT_PEAKS)

    }


    table["_predictor_order"] = (

        table["Peak"]
        .map(predictor_order)

    )


    table = table.sort_values(

        [
            "_predictor_order",
            "_parameter_order"

        ]

    )


    table = table.drop(

        columns=[

            "_parameter_order",
            "_predictor_order",

        ]

    )


    return table


